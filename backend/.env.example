# Copy to .env and fill in your values

DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-long-random-string

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/parish_songs

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS origins (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173
